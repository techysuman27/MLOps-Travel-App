FROM python:3.13-slim
WORKDIR /app
RUN pip install --no-cache-dir streamlit==1.65.0 requests==2.34.2 pandas==3.0.1
COPY app ./app
RUN useradd --uid 10001 --create-home voyage
USER voyage
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=3)"
CMD ["streamlit", "run", "app/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
